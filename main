local function ApplyLanguage()
    for _, r in ipairs(textRegistry) do
        pcall(function()
            local txt = r.ru
            if CurrentLang == "EN" and ENMap[r.ru] then txt = ENMap[r.ru] end
            if r.upper then txt = string.upper(txt) end
            r.inst.Text = txt
        end)
    end
end

