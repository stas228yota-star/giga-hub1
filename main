-- ══════════════════ ВКЛАДКИ ══════════════════
local tabButtons, pages = {}, {}
local currentTab = nil
local widgetOrder = 0
local function nextOrder()
    widgetOrder = widgetOrder + 1
    return widgetOrder
end

local function refreshTabColors()
    for _, t in ipairs(tabButtons) do
        local selected = (t.name == currentTab)
        t.lbl.TextColor3 = selected and THEME.Text or THEME.SubText
        t.icon.TextColor3 = selected and THEME.Accent or THEME.SubText
        t.bar.Visible = selected
    end
end
OnThemeChange(refreshTabColors)

local function switchTab(name)
    currentTab = name
    for n, page in pairs(pages) do page.Visible = (n == name) end
    refreshTabColors()
end

local function AddTabLabel(text)
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 20),
        Font = THEME.Font,
        TextSize = 9,
        TextColor3 = THEME.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = string.upper(text),
        LayoutOrder = nextOrder(),
        Parent = tabHolder,
    })
    RegisterText(lbl, string.upper(text), true)
    RegFont(lbl, "Font", "Font")
    RegColor(lbl, "TextColor3", "SubText")
end

local function AddTab(icon, name)
    local btn = new("TextButton", {
        Text = "",
        BackgroundTransparency = true,
        Size = UDim2.new(1, 0, 0, 28),
        AutoButtonColor = true,
        LayoutOrder = nextOrder(),
        Parent = tabHolder,
    })
    local bar = new("Frame", {
        BackgroundColor3 = THEME.Accent,
        Size = UDim2.new(0, 3, 0, 14),
        Position = UDim2.new(0, 0, 0.5, -7),
        Visible = false,
        Parent = btn,
    })
    makeCorner(bar, 2)
    RegColor(bar, "BackgroundColor3", "Accent")
    local iconLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Font = THEME.Font,
        TextSize = 13,
        TextColor3 = THEME.SubText,
        Text = icon,
        Parent = btn,
    })
    RegFont(iconLbl, "Font", "Font")
    RegColor(iconLbl, "TextColor3", "SubText")
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 36, 0, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Font = THEME.Font,
        TextSize = 12,
        TextColor3 = THEME.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = name,
        Parent = btn,
    })
    RegisterText(lbl, name)
    RegFont(lbl, "Font", "Font")
    RegColor(lbl, "TextColor3", "SubText")

    local page = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        BorderSizePixel = 0,
        Parent = content,
    })
    RegColor(page, "ScrollBarImageColor3", "Accent")
    new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
        Parent = page,
    })

    btn.MouseButton1Click:Connect(function() switchTab(name) end)
    tabButtons[#tabButtons + 1] = {name = name, btn = btn, lbl = lbl, icon = iconLbl, bar = bar}
    pages[name] = page
    refreshTabColors()
    return page
end

-- ══════════════════ КАРТОЧКИ ══════════════════
local rowMeta = {}
local function ensureRow(page)
    rowMeta[page] = rowMeta[page] or {}
    local rows = rowMeta[page]
    local last = rows[#rows]
    if last and last.count < 2 then
        return last
    end
    local rowF = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = nextOrder(),
        Parent = page,
    })
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Left, Parent = rowF})
    local entry = {frame = rowF, count = 0}
    rows[#rows + 1] = entry
    return entry
end

local function AddCard(page, title, half)
    local entry = ensureRow(page)
    entry.count = entry.count + 1
    local width = UDim2.new(1, -8, 0, 0)
    if half then
        width = UDim2.new(0.5, -4, 0, 0)
    end
    local card = new("Frame", {
        BackgroundColor3 = THEME.Element,
        BackgroundTransparency = 0.45,
        Size = width,
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = entry.frame,
    })
    makeCorner(card, 10)
    makeStroke(card)
    RegColor(card, "BackgroundColor3", "Element")
    local header = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -24, 0, 34),
        Font = THEME.TitleFont,
        TextSize = 14,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = title,
        Parent = card,
    })
    RegisterText(header, title)
    RegFont(header, "Font", "TitleFont")
    RegColor(header, "TextColor3", "Text")
    local body = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 36),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    })
    new("UIListLayout", {Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body})
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10),
        Parent = body,
    })
    return body
end

local function AddLabel(parent, text, colorKey, height)
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height or 18),
        Font = THEME.Font,
        TextSize = 11,
        TextColor3 = THEME[colorKey or "SubText"],
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    RegisterText(lbl, text)
    RegFont(lbl, "Font", "Font")
    RegColor(lbl, "TextColor3", colorKey or "SubText")
    return lbl
end

local function AddToggle(parent, label, default, callback, settingsKey)
    local row = new("TextButton", {
        Text = "", AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 2, 0, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = THEME.Font,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = label,
        Parent = row,
    })
    RegisterText(lbl, label)
    RegFont(lbl, "Font", "Font")
    RegColor(lbl, "TextColor3", "Text")
    local sw = new("Frame", {
        BackgroundColor3 = THEME.Element,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 36, 0, 19),
        Parent = row,
    })
    makeCorner(sw, 10)
    RegColor(sw, "BackgroundColor3", "Element")
    local knob = new("Frame", {
        BackgroundColor3 = THEME.SubText,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 13, 0, 13),
        Parent = sw,
    })
    makeCorner(knob, 7)
    RegColor(knob, "BackgroundColor3", "SubText")

    local state = default and true or false
    local function setVisual(s)
        state = s and true or false
        local targetPos = state and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        local targetCol = state and THEME.Accent or THEME.SubText
        local swCol = state and THEME.Accent or THEME.Element
        TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Position = targetPos, BackgroundColor3 = targetCol}):Play()
        TweenService:Create(sw, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {BackgroundColor3 = swCol}):Play()
    end
    row.MouseButton1Click:Connect(function()
        setVisual(not state)
        if callback then pcall(callback, state) end
    end)
    setVisual(state)
    if settingsKey then UISync[settingsKey] = setVisual end
    return setVisual
end

local function AddSlider(parent, label, min, max, default, callback, decimal)
    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 44),
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 2, 0, 0),
        Size = UDim2.new(1, -80, 0, 16),
        Font = THEME.Font,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = label,
        Parent = holder,
    })
    RegisterText(lbl, label)
    RegFont(lbl, "Font", "Font")
    RegColor(lbl, "TextColor3", "Text")
    local valLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 60, 0, 16),
        Font = THEME.Font,
        TextSize = 12,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = "",
        Parent = holder,
    })
    RegFont(valLbl, "Font", "Font")
    RegColor(valLbl, "TextColor3", "Text")
    local hit = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 2, 0, 24),
        Size = UDim2.new(1, -4, 0, 16),
        Parent = holder,
    })
    local track = new("Frame", {
        BackgroundColor3 = THEME.Element,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 5),
        Parent = hit,
    })
    makeCorner(track, 3)
    RegColor(track, "BackgroundColor3", "Element")
    local fill = new("Frame", {
        BackgroundColor3 = THEME.Accent,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = track,
    })
    makeCorner(fill, 3)
    RegColor(fill, "BackgroundColor3", "Accent")
    local knob = new("Frame", {
        BackgroundColor3 = THEME.Accent,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12),
        Parent = hit,
    })
    makeCorner(knob, 6)
    RegColor(knob, "BackgroundColor3", "Accent")

    local function setValue(v, fire)
        v = math.clamp(v, min, max)
        local frac = (max - min) > 0 and (v - min) / (max - min) or 0
        fill.Size = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, 0, 0.5, 0)
        if decimal then
            valLbl.Text = string.format("%.1f", v)
        else
            valLbl.Text = tostring(math.floor(v + 0.5))
        end
        if fire and callback then pcall(callback, v) end
    end

    local dragging = false
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if input.UserInputType == Enum.UserInputType.MouseMovement
                and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                dragging = false
                return
            end
            local mouseX = UserInputService:GetMouseLocation().X
            local frac = math.clamp((mouseX - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
            setValue(min + frac * (max - min), true)
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    setValue(default, false)
    return setValue
end

local function AddButton(parent, text, callback, colorKey)
    local btn = new("TextButton", {
        BackgroundColor3 = THEME[colorKey or "Element"],
        Size = UDim2.new(1, 0, 0, 30),
        Font = THEME.Font,
        TextSize = 12,
        TextColor3 = THEME.Text,
        Text = text,
        AutoButtonColor = true,
        LayoutOrder = nextOrder(),
        Parent = parent,
    })
    makeCorner(btn, 8)
    RegisterText(btn, text)
    RegColor(btn, "BackgroundColor3", colorKey or "Element")
    RegFont(btn, "Font", "Font")
    RegColor(btn, "TextColor3", "Text")
    btn.MouseButton1Click:Connect(function() pcall(callback) end)
    return btn
end

Notify = function(title, text, dur, color)
    if not Settings.Notifications then return end
    dur = dur or 3
    local n = new("Frame", {
        BackgroundColor3 = THEME.Element,
        Size = UDim2.new(0, 260, 0, 0),
        LayoutOrder = -os.clock(),
        Parent = notifyHolder,
    })
    makeCorner(n, 10)
    local st = new("UIStroke", {Thickness = 1, Color = color or THEME.Accent, Parent = n})
    RegColor(st, "Color", "Accent")
    local ttl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 5),
        Size = UDim2.new(1, -20, 0, 18),
        Font = THEME.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = THEME.Text,
        Text = title,
        Parent = n,
    })
    RegFont(ttl, "Font", "Font")
    RegColor(ttl, "TextColor3", "Text")
    local msg = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 23),
        Size = UDim2.new(1, -20, 1, -29),
        Font = THEME.Font,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextColor3 = THEME.SubText,
        Text = text,
        Parent = n,
    })
    RegFont(msg, "Font", "Font")
    RegColor(msg, "TextColor3", "SubText")
    TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 260, 0, 58)}):Play()
    task.delay(dur, function()
        pcall(function()
            local out = TweenService:Create(n, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {Size = UDim2.new(0, 260, 0, 0)})
            out.Completed:Connect(function() n:Destroy() end)
            out:Play()
        end)
    end)
end

