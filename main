local minBtn = new("TextButton", {
    BackgroundColor3 = THEME.Element,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -38, 0, 8),
    Size = UDim2.new(0, 24, 0, 24),
    Font = THEME.Font,
    TextSize = 14,
    TextColor3 = THEME.Text,
    Text = "—",
    AutoButtonColor = true,
    Parent = window,
})
makeCorner(minBtn, 6)
