        local typed = tostring(keyBox.Text or ""):gsub("%s", "")
        if typed == "" then
            say("Пусто?! Ключ сам себя не введёт 🤓")
            shake()
            return
        end
        if string.lower(typed) == string.lower("0x7CkeyMM2free") then
            say("ВЕРНО! 🔓 Запускаю TeamGiga...")
            KEY_OK = true
            task.delay(0.55, function()
                pcall(function() backdrop:Destroy() end)
                if startMainUI then pcall(startMainUI) end
            end)
        else
            say(funnyWrong[math.random(1, #funnyWrong)])
            shake()
        end
    end
    getBtn.MouseButton1Click:Connect(function()
        pcall(function() setclipboard("https://discord.gg/gE6w5X64E3") end)
        say("Ссылка на наш ДС скопирована! Вставь в браузер 🌐")
    end)
    checkBtn.MouseButton1Click:Connect(checkKey)
    keyBox.FocusLost:Connect(function(enter)
        if enter then checkKey() end
    end)
end

startMainUI = function()
-- ══════════════════ ШАГ 1: WELCOME (сначала он) ══════════════════
local function playWelcome()
pcall(function()
    local wcHolder = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 50,
        Parent = ScreenGui,
    })
    local wcLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        TextTransparency = 0,
        Size = UDim2.new(0.85, 0, 0.35, 0),
        Position = UDim2.new(0.075, 0, 0.3, 0),
        Font = THEME.TitleFont,
        Text = "WELCOME",
        TextScaled = true,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 51,
        Parent = wcHolder,
    })
    local wcStroke = new("UIStroke", {Thickness = 3, Color = Color3.fromRGB(255, 0, 0), Parent = wcLbl})
    local wcGrad = Instance.new("UIGradient")
    wcGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 200, 0)),
        ColorSequenceKeypoint.new(0.40, Color3.fromRGB(0, 255, 80)),
        ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 200, 255)),
        ColorSequenceKeypoint.new(0.80, Color3.fromRGB(170, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
    })
    wcGrad.Parent = wcLbl
    -- Радужная анимация: градиент бежит, обводка крутит оттенки
    task.spawn(function()
        local t0 = os.clock()
        while ScreenGui.Parent and wcHolder.Parent do
            pcall(function()
                local t = os.clock() - t0
                wcGrad.Offset = Vector2.new((t * 0.5) % 1, 0)
                wcStroke.Color = Color3.fromHSV((t * 0.6) % 1, 1, 1)
            end)
            task.wait(0.03)
        end
    end)
    -- Скрыть через 3.5с: плавный фейд
    task.delay(3.5, function()
        pcall(function()
            local out = TweenService:Create(wcLbl,
                TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {TextTransparency = 1, BackgroundTransparency = 1})
            out:Play()
            TweenService:Create(wcStroke, TweenInfo.new(0.8), {Transparency = 1}):Play()
            task.wait(0.85)
            wcHolder:Destroy()
        end)
    end)
end)
end -- playWelcome

