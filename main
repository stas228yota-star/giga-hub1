RegFont(minBtn, "Font", "Font")
RegColor(minBtn, "TextColor3", "Text")

local dragging = false
local dragStart, startPos
local function beginDrag(input)
    dragging = true
    dragStart = input.Position
    startPos = window.Position
end
dragBar.InputBegan:Connect(beginDrag)
logo.InputBegan:Connect(beginDrag)
Connect(UserInputService.InputChanged, function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        -- ФИКС "сам прицепляется": если ЛКМ уже отпущена — сразу прекращаем драг
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            dragging = false
            return
        end
        local delta = input.Position - dragStart
        window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
Connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    local target = minimized and UDim2.new(0, 640, 0, 46) or UDim2.new(0, 640, 0, 460)
    TweenService:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = target}):Play()
    task.delay(0.1, function()
        sidebar.Visible = not minimized
        content.Visible = not minimized
    end)
end)
closeBtn.MouseButton1Click:Connect(function()
    if Unload then Unload() end
end)
local uiVisible = true
local function setWindowVisible(on)
    -- Плавное открытие/закрытие: фейд + лёгкое масштабирование
    if on then
        window.Visible = true
        window.BackgroundTransparency = 1
        TweenService:Create(window, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {BackgroundTransparency = 0.3}):Play()
        local startSize = UDim2.new(0, 640, 0, 420)
        window.Size = startSize
        TweenService:Create(window, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size = UDim2.new(0, 640, 0, 460)}):Play()
    else
        local tw = TweenService:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {BackgroundTransparency = 1, Size = UDim2.new(0, 640, 0, 420)})
        tw.Completed:Connect(function()
            if not uiVisible then window.Visible = false end
        end)
        tw:Play()
    end
end
toggleGui = function()
    uiVisible = not uiVisible
    setWindowVisible(uiVisible)
end

-- ══════════════════ ВВОД (бинд аима) ══════════════════
Connect(UserInputService.InputBegan, function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdAimRMB = true
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = input.KeyCode
    if waitingBindTarget then
        if k ~= Enum.KeyCode.Escape then
            Settings.AimKey = k.Name
            if BindButton then BindButton.Text = k.Name end
            if Notify then Notify("Бинд", "AIM -> " .. k.Name, 2, THEME.Success) end
        else
            if Notify then Notify("Бинд", "Отменено", 2, THEME.Danger) end
        end
        waitingBindTarget = nil
        return
    end
    if k == Enum.KeyCode.RightControl then
        toggleGui()
        return
    end
    if not gp and k.Name == Settings.AimKey then
        holdAimKey = true
    end
end)

Connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        holdAimRMB = false
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode.Name == Settings.AimKey then
        holdAimKey = false
    end
end)

-- ══════════════════ АНТИ-АФК ══════════════════
Connect(LocalPlayer.Idled, function()
    if Settings.AntiAFK then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end)

-- ══════════════════ ВЫГРУЗКА ══════════════════
Unload = function()
    scriptAlive = false
    -- Плавное закрытие перед уничтожением
    pcall(function()
        window.BackgroundTransparency = 1
        window.Visible = false
    end)
    destroyFovCircle()
    destroyWeaponEsp()
    pcall(function()
        if Humanoid and Humanoid.Parent then Humanoid.WalkSpeed = 16 end
    end)
    for _, e in pairs(EspEntries) do
        pcall(function() if e.billboard then e.billboard:Destroy() end end)
        pcall(function() if e.highlight then e.highlight:Destroy() end end)
    end
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}
    pcall(function() ScreenGui:Destroy() end)
    print("[TeamGiga MM2] выгружен")
end

-- ══════════════════ СТАРТ ══════════════════
switchTab("Игрок")

task.delay(1.5, function()
    if Notify then
        local mur, sher = 0, 0
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                local r = getRole(pl)
                if r == "MURDERER" then mur = mur + 1 end
                if r == "SHERIFF" then sher = sher + 1 end
            end
        end
        Notify("TEAMGIGA " .. SCRIPT_VERSION,
            "Готов! AIM = [" .. Settings.AimKey .. "]/ПКМ. Сейчас в раунде: убийц " .. mur .. ", шерифов " .. sher,
            6, THEME.Accent)
    end
end)

end -- конец buildMain

-- Сначала WELCOME, через ~2.8с плавно поднимается основное меню
playWelcome()
task.delay(2.8, function()
    if scriptAlive and KEY_OK then pcall(buildMain) end
end)
end -- конец startMainUI (запуск после верного ключа)

print("[TeamGiga MM2 " .. SCRIPT_VERSION .. "] загружен — жду ключ 0x7C...")

end) -- конец pcall-обёртки

if not TG_OK then
    local msg = tostring(TG_ERR)
    warn("[TeamGiga MM2] ОШИБКА ЗАПУСКА: " .. msg)
    pcall(function() messagebox(string.sub(msg, 1, 250), "TeamGiga MM2 - ОШИБКА", 0) end)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "TEAMGIGA MM2 - ОШИБКА!",
            Text = string.sub(msg, 1, 100),
            Duration = 20
        })
    end)
else
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "TeamGiga MM2 v2.7",
            Text = "Скрипт загружен! Введи ключ 0x7C 😼",
            Duration = 6
        })
    end)
end
