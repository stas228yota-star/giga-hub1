    local c = signal:Connect(fn)
    Connections[#Connections + 1] = c
    return c
end

-- ══════════════════ ПЕРСОНАЖ ══════════════════
local function onCharacterAdded(char)
    Character = char
    Humanoid = nil
    HumanoidRootPart = nil
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 10)
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not hum or not hum.Parent or LocalPlayer.Character ~= char then return end
        Humanoid = hum
        HumanoidRootPart = root
    end)
end
Connect(LocalPlayer.CharacterAdded, onCharacterAdded)
if LocalPlayer.Character then task.spawn(onCharacterAdded, LocalPlayer.Character) end

-- ══════════════════ SPEEDHACK (анти-откат) ══════════════════
Connect(RunService.Heartbeat, function()
    if Humanoid and Humanoid.Parent and Humanoid.Health > 0 and Settings.SpeedHack then
        Humanoid.WalkSpeed = Settings.Speed
    end
end)

-- ══════════════════ INF JUMP ══════════════════
Connect(UserInputService.JumpRequest, function()
    if Settings.InfJump and Humanoid and Humanoid.Parent and Humanoid.Health > 0 then
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
end)

-- ══════════════════ 🔫 ОРУЖИЕ (дроп шерифа) ══════════════════
local GUN_KEYWORDS = {"gun", "revolver", "pistol", "оружи", "weapon"}
local droppedGun = nil
local gunWasPresent = false
local gunEspEntry = {billboard = nil, highlight = nil}
-- Событийный кэш: копим оружие через DescendantAdded (0 сканов = 0 лагов),
-- отсеиваем оружие В РУКАХ (иначе ТП срабатывает когда шериф ДОСТАЁТ пушку)
local GunCache = {}

local function isHeldByCharacter(obj)
    local node = obj.Parent
    for _ = 1, 4 do
        if not node or node == workspace then break end
        local hasHum = false
        pcall(function() hasHum = node:FindFirstChildOfClass("Humanoid") ~= nil end)
        if hasHum then return true end
        node = node.Parent
    end
    return false
end

local function watchGun(obj)
    if not isGunObject(obj) then return end
    task.delay(0.05, function()
        if obj.Parent and not isHeldByCharacter(obj) then
            GunCache[obj] = true
        end
    end)
end

local function currentGun()
    for g in pairs(GunCache) do
        if g.Parent == nil then
            GunCache[g] = nil
        elseif isHeldByCharacter(g) then
            GunCache[g] = nil
        else
            return g
        end
    end
    return nil
end

local function isGunObject(obj)
    if not obj or not obj.Parent then return false end
    local isTool = false
    local isModel = false
    pcall(function() isTool = obj:IsA("Tool") end)
    pcall(function() isModel = obj:IsA("Model") end)
    if not (isTool or isModel) then return false end
    local nm = string.lower(obj.Name)
    if isTool then
        for _, kw in ipairs(GUN_KEYWORDS) do
            if string.find(nm, kw, 1, true) then return true end
        end
        return false
    end
    -- Model: только точное имя (иначе ловим карту типа GunShop - ложные ТП)
    for _, kw in ipairs(GUN_KEYWORDS) do
        if nm == kw then return true end
    end
    return false
end

local function gunPosition(obj)
    local part = nil
    pcall(function()
        if obj:IsA("Tool") then
            part = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
        else
            part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        end
    end)
    if part and part.Position then return part.Position, part end
    return nil, nil
end

-- ЛЕГКИЙ скан (урок по лагам): только верх workspace + 1 уровень в папки
local function findDroppedGun()
    local ok, kids = pcall(function() return workspace:GetChildren() end)
    if ok and kids then
        for _, obj in ipairs(kids) do
            if isGunObject(obj) then return obj end
            local cls = obj.ClassName
            if cls == "Folder" or cls == "Model" then
                local ok2, kids2 = pcall(function() return obj:GetChildren() end)
                if ok2 and kids2 then
                    for _, o2 in ipairs(kids2) do
                        if isGunObject(o2) then return o2 end
                    end
                end
            end
        end
    end
    return nil
end

local function teleportCFrame(pos)
    local root = HumanoidRootPart or (Character and Character:FindFirstChild("HumanoidRootPart"))
    if not root then
        if Notify then Notify("🔫 ТП", "Персонаж не найден", 3, THEME.Danger) end
        return false
    end
    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    return true
end

local function destroyWeaponEsp()
    if gunEspEntry.billboard then pcall(function() gunEspEntry.billboard:Destroy() end) end
    if gunEspEntry.highlight then pcall(function() gunEspEntry.highlight:Destroy() end) end
    gunEspEntry.billboard = nil
    gunEspEntry.highlight = nil
end

local function buildWeaponEsp(obj, part)
    destroyWeaponEsp()
    pcall(function()
        local bb = Instance.new("BillboardGui")
        bb.Name = "TG_GUN"
        bb.Adornee = part
        bb.Size = UDim2.new(0, 160, 0, 40)
        bb.StudsOffset = Vector3.new(0, 1.5, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = 5000
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.Text = "🔫 ОРУЖИЕ"
        lbl.TextColor3 = Color3.fromRGB(255, 220, 60)
        lbl.TextStrokeTransparency = 0.3
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Parent = bb
        bb.Parent = part

        local hl = Instance.new("Highlight")
        hl.Name = "TG_GUN_HL"
        hl.Adornee = obj
        hl.FillColor = Color3.fromRGB(255, 220, 60)
        hl.OutlineColor = Color3.fromRGB(255, 220, 60)
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0.05
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = obj

        gunEspEntry.billboard = bb
        gunEspEntry.highlight = hl
    end)
end

local function weaponTick()
    local gun = currentGun()
    local appeared = (gun ~= nil) and (not gunWasPresent)
    droppedGun = gun
    if Settings.WeaponESP and gun then
        local _, part = gunPosition(gun)
        if part then
            local needRebuild = (gunEspEntry.billboard == nil)
            pcall(function() needRebuild = (gunEspEntry.billboard.Adornee ~= part) end)
            if needRebuild then buildWeaponEsp(gun, part) end
        end
    else
        destroyWeaponEsp()
    end
    if appeared and Settings.WeaponAutoTP and gun then
        local pos = gunPosition(gun)
        if pos then
            task.delay(0.1, function()
                if teleportCFrame(pos) and Notify then
                    Notify("🔫 Оружие", "Шериф умер — телепортирован к оружию!", 4, THEME.Accent)
                end
            end)
        end
    end
    gunWasPresent = (gun ~= nil)
end

-- МГНОВЕННАЯ реакция: оружие только что выпало -> ТП сразу
do
    pcall(function()
        local connW = workspace.DescendantAdded:Connect(function(obj)
            if not isGunObject(obj) then return end
            -- В кэш - всегда (для ВХ). ТП - только если оружие ЛЕЖИТ (не в руках!)
            watchGun(obj)
            if Settings.WeaponAutoTP then
                task.delay(0.15, function()
                    if KEY_OK and obj.Parent and not isHeldByCharacter(obj) then
                        local pos = gunPosition(obj)
                        if pos and teleportCFrame(pos) and Notify then
                            Notify("🔫 Оружие", "Оружие выпало — телепортирован!", 4, THEME.Accent)
                        end
                    end
                end)
            end
        end)
        if connW then Connections[#Connections + 1] = connW end
    end)
end

-- ТП к оружию с ретраями: после смерти пушка появляется с задержкой
local function tryGrabGunSoon()
    -- Кто-то сейчас подберёт пушку: форсируем пересчёт ролей несколько раз,
    -- чтобы новый шериф сразу подсветился синим
    for _, d in ipairs({0.5, 1.5, 3, 5}) do
        task.delay(d, function()
            if scriptAlive then pcall(refreshRoles) end
        end)
    end
    if not Settings.WeaponAutoTP then return end
    for _, d in ipairs({0.2, 0.5, 0.9, 1.4, 2.0, 2.7, 3.5, 4.5}) do
        task.delay(d, function()
            if not scriptAlive or not Settings.WeaponAutoTP then return end
            local gun = currentGun()
            if gun then
                local pos = gunPosition(gun)
                if pos and teleportCFrame(pos) and Notify then
                    Notify("🔫 Оружие", "Шериф умер — телепортирован к оружию!", 4, THEME.Accent)
                end
            end
        end)
    end
end

-- Хук смерти КАЖДОГО игрока: умер -> сразу ищем дроп (4 попытки за 2 секунды)
local function hookDeath(pl)
    local function bindHum(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            if hum and hum.Parent then
                hum.Died:Connect(function()
                    tryGrabGunSoon()
                end)
            end
        end)
    end
    Connect(pl.CharacterAdded, bindHum)
    if pl.Character then bindHum(pl.Character) end
end
for _, pl in ipairs(Players:GetPlayers()) do hookDeath(pl) end
Connect(Players.PlayerAdded, hookDeath)

-- Быстрый скан (0.3с) как страховка
task.spawn(function()
    task.wait(1)
    pcall(function()
        local ok, kids = pcall(function() return workspace:GetChildren() end)
        if ok and kids then
            for _, obj in ipairs(kids) do watchGun(obj) end
        end
    end)
end)

-- Обновление ESP/статуса из кэша (без сканов)
task.spawn(function()
    while scriptAlive do
        task.wait(1)
        if KEY_OK and (Settings.WeaponESP or Settings.WeaponAutoTP) then
            pcall(weaponTick)
        end
    end
end)

local function tpToWeapon()
    if not KEY_OK then return end
    local gun = currentGun() or droppedGun
    if not gun then
        if Notify then Notify("🔫 Оружие", "Оружие на карте не найдено", 3, THEME.Danger) end
        return
    end
    local pos = gunPosition(gun)
    if pos and teleportCFrame(pos) then
        if Notify then Notify("🔫 Оружие", "Телепортирован к оружию!", 3, THEME.Success) end
    else
        if Notify then Notify("🔫 Оружие", "Не нашёл позицию оружия", 3, THEME.Danger) end
    end
end

-- ══════════════════ ЗАГЛУШКА Auto-Gun (удалён по просьбе) ══════════════════
local function autoGunFire()
    if autoGunBusy then return end
    if not Settings.AutoGun then
        if Notify then Notify("Auto-Gun", "Выключен — включи на вкладке ТП", 3, THEME.Danger) end
        return
    end
    local gun = currentGun() or droppedGun
    if not gun then
        if Notify then Notify("Auto-Gun", "Оружия на карте нет", 3, THEME.Danger) end
        return
    end
    local root = HumanoidRootPart or (Character and Character:FindFirstChild("HumanoidRootPart"))
    if not root then return end
    if Notify then Notify("Auto-Gun", "Удалён. Используй Авто-ТП на вкладке ESP", 3, THEME.Accent) end
end

-- ТП к игроку по роли (Убийца/Шериф)
local function tpToRole(roleName, roleTitle)
    refreshRoles()
    for pl, r in pairs(RoleCache) do
        if r == roleName and pl.Parent then
            local char = pl.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local behind = hrp.CFrame.LookVector * -3
                if teleportCFrame(hrp.Position + behind) then
                    if Notify then Notify(roleTitle, "Телепортирован!", 3, THEME.Success) end
                end
                return
            end
        end
    end
    if Notify then Notify(roleTitle, "Сейчас такой игрок не найден (раунд перезагрузится)", 3, THEME.Danger) end
end

-- ══════════════════ 🎭 РОЛИ MM2 ══════════════════
-- Убийца носит Knife, Шериф носит Gun/Revolver, остальные — мирные.
-- Проверяем и персонажа, и рюкзак (нож может лежать там).
local MURDERER_TOOLS = {knife = true, knife0 = true}
local SHERIFF_TOOLS  = {gun = true, revolver = true, pistol = true}

local function playerHasTool(pl, names)
    local containers = {}
    if pl.Character then containers[#containers + 1] = pl.Character end
    local bp = pl:FindFirstChild("Backpack")
    if bp then containers[#containers + 1] = bp end
    for _, cont in ipairs(containers) do
        -- ГЛУБОКИЙ поиск: оружие после подбора может лежать НЕ прямым ребёнком
        -- (вложено в Model в персонаже и т.п.), поэтому GetDescendants
        local ok, all = pcall(function() return cont:GetDescendants() end)
        local kids = ok and all or {}
        -- плюс прямые дети на всякий случай
        pcall(function()
            for _, t in ipairs(cont:GetChildren()) do kids[#kids + 1] = t end
        end)
        for _, t in ipairs(kids) do
            local isTool = false
            pcall(function() isTool = t:IsA("Tool") end)
            if isTool then
                local nm = string.lower(t.Name)
                if names[nm] then return true end
                -- "КлассическийНож"/"Knife1234" - подстрока тоже ловим
                for toolName in pairs(names) do
                    if string.find(nm, toolName, 1, true) then return true end
                end
            end
        end
    end
    return false
end

local function getRole(pl)
    if playerHasTool(pl, MURDERER_TOOLS) then return "MURDERER" end
    if playerHasTool(pl, SHERIFF_TOOLS) then return "SHERIFF" end
    return "INNOCENT"
end

-- Кэш ролей: аим/ТП не сканируют Backpack каждый кадр (лаг-фикс)
local RoleCache = {}
local function refreshRoles()
    if not KEY_OK then return end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            RoleCache[pl] = getRole(pl)
        end
    end
end

local ROLE_TEXT = {
    MURDERER = "🔪 УБИЙЦА",
    SHERIFF  = "⭐ ШЕРИФ",
    INNOCENT = "🧑 МИРНЫЙ",
}
local ROLE_COLOR_KEY = {
    MURDERER = "MurdererColor",
    SHERIFF  = "SheriffColor",
    INNOCENT = "InnocentColor",
}

-- ══════════════════ 👁 ESP НА РОЛИ ══════════════════
local EspEntries = {}   -- [player] = {billboard, nameLbl, roleLbl, distLbl, highlight, role}

local function buildEsp(pl, entry, char)
    task.spawn(function()
        local head = char:WaitForChild("Head", 6)
            or char:WaitForChild("Torso", 2)
            or char:WaitForChild("HumanoidRootPart", 2)
        if not head or not char.Parent or not scriptAlive then return end
        if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
        if entry.highlight then pcall(function() entry.highlight:Destroy() end) end

        local bb = Instance.new("BillboardGui")
        bb.Name = "TG_ESP"
        bb.Adornee = head
        bb.Size = UDim2.new(0, 220, 0, 76)
        bb.StudsOffset = Vector3.new(0, 2.3, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = 5000

        local nameLbl = Instance.new("TextLabel")
        nameLbl.BackgroundTransparency = 1
        nameLbl.Size = UDim2.new(1, 0, 0, 25)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 15
        nameLbl.Text = pl.Name
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.TextStrokeTransparency = 0.35
        nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLbl.Parent = bb

        local roleLbl = Instance.new("TextLabel")
        roleLbl.BackgroundTransparency = 1
        roleLbl.Position = UDim2.new(0, 0, 0, 25)
        roleLbl.Size = UDim2.new(1, 0, 0, 25)
        roleLbl.Font = Enum.Font.GothamBold
        roleLbl.TextSize = 14
        roleLbl.Text = ROLE_TEXT.INNOCENT
        roleLbl.TextColor3 = THEME.InnocentColor
        roleLbl.TextStrokeTransparency = 0.35
        roleLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        roleLbl.Parent = bb

        local distLbl = Instance.new("TextLabel")
        distLbl.BackgroundTransparency = 1
        distLbl.Position = UDim2.new(0, 0, 0, 50)
        distLbl.Size = UDim2.new(1, 0, 0, 22)
        distLbl.Font = Enum.Font.Gotham
        distLbl.TextSize = 13
        distLbl.Text = "0 м"
        distLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
        distLbl.TextStrokeTransparency = 0.35
        distLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distLbl.Parent = bb

        bb.Parent = head

        local hl = nil
        pcall(function()
            hl = Instance.new("Highlight")
            hl.Name = "TG_HL"
            hl.Adornee = char
            hl.FillTransparency = 0.8
            hl.OutlineTransparency = 0.1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end)

        entry.head = head
        entry.billboard = bb
        entry.nameLbl = nameLbl
        entry.roleLbl = roleLbl
        entry.distLbl = distLbl
        entry.highlight = hl
        entry.role = getRole(pl)
    end)
end

local function setupEsp(pl)
    if pl == LocalPlayer or EspEntries[pl] then return end
    local entry = {}
    EspEntries[pl] = entry
    Connect(pl.CharacterAdded, function(char)
        buildEsp(pl, entry, char)
    end)
    if pl.Character then buildEsp(pl, entry, pl.Character) end
end

for _, pl in ipairs(Players:GetPlayers()) do setupEsp(pl) end
Connect(Players.PlayerAdded, setupEsp)
Connect(Players.PlayerRemoving, function(pl)
    local e = EspEntries[pl]
    if e then
        if e.billboard then pcall(function() e.billboard:Destroy() end) end
        if e.highlight then pcall(function() e.highlight:Destroy() end) end
        EspEntries[pl] = nil
    end
end)

-- Обновление ESP (лёгкий цикл 0.2с) + пересчёт ролей раз в 1.5с
task.spawn(function()
    while scriptAlive do
        task.wait(0.2)
        if KEY_OK and Settings.ESP then
            local cam = workspace.CurrentCamera
            local camPos = cam and cam.CFrame.Position or Vector3.zero
            for pl, e in pairs(EspEntries) do
                local char = pl.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local visible = e.billboard ~= nil and e.head ~= nil and e.head.Parent ~= nil and root ~= nil
                if visible then
                    local dist = (root.Position - camPos).Magnitude
                    local role = e.role or "INNOCENT"
                    local roleOn
                    if role == "MURDERER" then
                        roleOn = Settings.EspMurderer
                    elseif role == "SHERIFF" then
                        roleOn = Settings.EspSheriff
                    else
                        roleOn = Settings.EspInnocent
                    end
                    local show = roleOn and dist <= 5000
                    e.billboard.Enabled = show
                    if e.highlight then e.highlight.Enabled = show and Settings.EspGlow end
                    if show then
                        e.nameLbl.Visible = Settings.EspNick
                        e.distLbl.Visible = Settings.EspDist
                        e.distLbl.Text = tostring(math.floor(dist + 0.5)) .. " м"
                        e.roleLbl.Text = ROLE_TEXT[role] or ROLE_TEXT.INNOCENT
                        local col = THEME[ROLE_COLOR_KEY[role]] or THEME.InnocentColor
                        e.roleLbl.TextColor3 = col
                        if e.highlight then
                            e.highlight.FillColor = col
                            e.highlight.OutlineColor = col
                        end
                    end
                elseif e.billboard then
                    e.billboard.Enabled = false
                    if e.highlight then e.highlight.Enabled = false end
                end
            end
        else
            for _, e in pairs(EspEntries) do
                if e.billboard then e.billboard.Enabled = false end
                if e.highlight then e.highlight.Enabled = false end
            end
        end
    end
end)

task.spawn(function()
    while scriptAlive do
        task.wait(1)
        pcall(refreshRoles)
        if Settings.ESP then
            for pl, e in pairs(EspEntries) do
                e.role = RoleCache[pl] or e.role
            end
        end
    end
end)

-- ══════════════════ 🎯 AIM (по бинду) ══════════════════
local function aimActive()
    if not Settings.AimOn then return false end
    if Settings.AimMode == "ALWAYS" then return true end
    return holdAimKey or (Settings.AimRMB and holdAimRMB)
end

local function getScreenCenter(cam)
    local vs = cam.ViewportSize or {X = 1920, Y = 1080}
    return (vs.X or 1920) / 2, (vs.Y or 1080) / 2
end

-- Цель: ближайшая в FOV. Приоритет Убийцы (для шерифа это маст-хэв).
-- AimOnlyMurderer = целимся ТОЛЬКО в убийцу.
local function findTarget(cam)
    -- КАК В ДРУГИХ ХАБАХ: цель = ближайшая к КУРСОРУ мыши (не к центру экрана)
    local cx, cy = getScreenCenter(cam)
    pcall(function()
        local ml = UserInputService:GetMouseLocation()
        if ml and ml.X then cx, cy = ml.X, ml.Y end
    end)
    local best, bestScore = nil, math.huge
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            local char = pl.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local head = char and char:FindFirstChild("Head")
            if head and hum and hum.Health > 0 then
                local role = RoleCache[pl] or getRole(pl)
                if not Settings.AimOnlyMurderer or role == "MURDERER" then
                    local ok, sp = pcall(function()
                        return cam:WorldToViewportPoint(head.Position)
                    end)
                    if ok and sp and sp.Z and sp.Z > 0 then
                        local dx, dy = (sp.X - cx), (sp.Y - cy)
                        local d = math.sqrt(dx * dx + dy * dy)
                        if d <= Settings.AimFov then
                            local score = d
                            if role == "MURDERER" then score = score - 100000 end
                            if score < bestScore then
                                best = head
                                bestScore = score
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function ensureFovCircle()
    -- Drawing API у части экзекуторов КРАШИТ клиент - потому по умолчанию выключен
    if fovCircle or not Settings.AimOn or not Settings.FovShow then return end
    pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 2
        fovCircle.NumSides = 64
        fovCircle.Radius = Settings.AimFov
        fovCircle.Filled = false
        fovCircle.Color = THEME.Accent
        fovCircle.Visible = false
    end)
end

local function destroyFovCircle()
    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end
end

local function aimFrame()
    local cam = workspace.CurrentCamera
    if not cam then return end

    -- FOV-круг
    if Settings.AimOn and Settings.FovShow then
        ensureFovCircle()
        if fovCircle then
            pcall(function()
                local ml = UserInputService:GetMouseLocation()
                if ml and ml.X then
                    fovCircle.Position = Vector2.new(ml.X, ml.Y)
                else
                    local cx, cy = getScreenCenter(cam)
                    fovCircle.Position = Vector2.new(cx, cy)
                end
                fovCircle.Radius = Settings.AimFov
                fovCircle.Color = THEME.Accent
                fovCircle.Visible = aimActive()
            end)
        end
    else
        destroyFovCircle()
    end

    -- Аим: mousemoverel (входной конвейер игры) с фолбэком на камеру
    if aimActive() then
        local head = findTarget(cam)
        if head then
            local ok, sp = pcall(function()
                return cam:WorldToViewportPoint(head.Position)
            end)
            if ok and sp and sp.X then
                local cx, cy = getScreenCenter(cam)
                local dx, dy = (sp.X - cx), (sp.Y - cy)
                local k = math.clamp(1 / math.max(Settings.AimSmooth, 1), 0.08, 1)
                if Settings.AimMouseMode and type(mousemoverel) == "function" then
                    -- Легит-режим: движение мыши
                    pcall(mousemoverel, dx * k, dy * k)
                else
                    -- ОСНОВНОЙ режим: доворот камеры (надёжно в MM2)
                    local alpha = k
                    local lookAtCF = CFrame.lookAt(cam.CFrame.Position, head.Position)
                    cam.CFrame = cam.CFrame:Lerp(lookAtCF, alpha)
                end
            end
        end
    end
end

-- ВАЖНО: вешаемся ПОСЛЕ камеры игры (Camera.Value + 1)
-- RenderStepped работает во ВСЕХ экзекуторах (BindToRenderStep у части
-- экзекуторов просто не вызывает колбэк - из-за этого аим "не работал")
aimBindState = "RenderStepped"
Connect(RunService.RenderStepped, aimFrame)

-- ══════════════════ GUI: ТОЧЬ-В-ТОЧЬ NEVERWIN ══════════════════
local function new(className, props, parent)
    local inst = Instance.new(className)
    local propsParent = (props and props.Parent) or nil
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    local targetParent = parent or propsParent
    if targetParent then inst.Parent = targetParent end
    return inst
end

local function makeCorner(inst, radius)
    local uc = new("UICorner", {CornerRadius = UDim.new(0, radius or THEME.Corner)})
    uc.Parent = inst
    RegCorner(uc)
    return uc
end

local function makeStroke(inst, thickness, key)
    local st = new("UIStroke", {Thickness = thickness or 1, Color = THEME[key or "StrokeThin"]})
    st.Parent = inst
    RegColor(st, "Color", key or "StrokeThin")
    return st
end

